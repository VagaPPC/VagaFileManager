From 815d6c2e8ecbe4f1f59ed562528ae7a2fd5f2ce7 Mon Sep 17 00:00:00 2001
From: Michele Dipace <michele.dipace@kaffeine.net>
Date: Sat, 21 Nov 2026 16:24:24 +0100
Subject: [PATCH 2/4] Fix: cancelling a move must not delete the source

CopyDirectoryRecursive left its loop on gProgCancel but still returned
TRUE, so MoveEntry deleted the whole source: cancelling at 224 of 1500
files lost the other 1276. The same happened on a read error in the middle
of a directory (ExamineDir returns NULL on errors too).

- CopyDirectoryRecursive returns FALSE when cancelled or when the loop did
  not end with ERROR_NO_MORE_ENTRIES
- MoveEntry never deletes the source after a cancel
---
 FileOps.c | 11 +++++++++++
 1 file changed, 11 insertions(+)

diff --git a/FileOps.c b/FileOps.c
index 4049afd..10addcf 100644
--- a/FileOps.c
+++ b/FileOps.c
@@ -330,6 +330,13 @@ BOOL CopyDirectoryRecursive(CONST_STRPTR src, CONST_STRPTR dst)
         }
         if (!CopyEntryRecursive(s, d)) ok = FALSE;
     }
+    /* The loop ends on cancel, at the end of the listing or on a read
+       error: only the end of the listing means "everything was copied".
+       Otherwise a move would also delete the entries never copied. */
+    if (gProgCancel)
+        ok = FALSE;
+    else if (IDOS->IoErr() != ERROR_NO_MORE_ENTRIES)
+        ok = FALSE;
     IDOS->ReleaseDirContext(ctx);
     CopyAttributes(src, dst);
     return ok;
@@ -810,6 +817,10 @@ BOOL MoveEntry(CONST_STRPTR src, CONST_STRPTR dst)
     {
         CONST_STRPTR finalDst = gCopyResolvedDst[0] ? gCopyResolvedDst : dst;
 
+        /* operation cancelled: the copy may be partial, the source must
+           never be deleted */
+        if (gProgCancel) return FALSE;
+
         /* se qualcosa e' stato saltato (conflitto), non eliminare il
            sorgente: resterebbe incompleto */
         if (gCopySkipped) return TRUE;
