From 38039e75c91739a8ede00440c763368e37dd9f79 Mon Sep 17 00:00:00 2001
From: Michele Dipace <michele.dipace@kaffeine.net>
Date: Sat, 21 Nov 2026 16:24:56 +0100
Subject: [PATCH 3/4] Fix: a file name with control characters must not run
 commands in a Shell

Text drops on Shells and requesters type the path with synthetic key
events, and BuildDropText only escaped " and *. A file named
"a<LF>Echo >x y<LF>" dropped on a Shell ran the command on the next Return
(with a <CR> in the name, immediately).

- BuildDropText rejects paths containing C0 controls, DEL or C1 controls
  (0x80-0x9F)
- TypeTextIntoWindow never types control characters (last line of defence)
---
 DragDrop.c | 26 ++++++++++++++++++++++++++
 1 file changed, 26 insertions(+)

diff --git a/DragDrop.c b/DragDrop.c
index 6fdff3b..970387a 100644
--- a/DragDrop.c
+++ b/DragDrop.c
@@ -238,6 +238,21 @@ static BOOL AppendText(char *buf, ULONG size, CONST_STRPTR text)
     return TRUE;
 }
 
+/* TRUE if the text contains characters that are not plain text when typed
+   into a window: C0 controls (Return, Ctrl-J, Esc...), DEL and C1 controls
+   (0x80-0x9F, including CSI 0x9B). A file name containing them, dropped on
+   a Shell, would run commands. */
+static BOOL HasControlChars(CONST_STRPTR s)
+{
+    const UBYTE *p;
+    for (p = (const UBYTE *)s; *p; p++)
+    {
+        if (*p < 0x20 || *p == 0x7F || (*p >= 0x80 && *p <= 0x9F))
+            return TRUE;
+    }
+    return FALSE;
+}
+
 static BOOL BuildDropText(char *buf, ULONG size, char (*paths)[PATH_MAX_LEN],
                           LONG count, BOOL forShell)
 {
@@ -246,6 +261,15 @@ static BOOL BuildDropText(char *buf, ULONG size, char (*paths)[PATH_MAX_LEN],
     if (!buf || size == 0) return FALSE;
     buf[0] = '\0';
 
+    for (i = 0; i < count; i++)
+    {
+        if (HasControlChars(paths[i]))
+        {
+            DBG("drop text: path with control characters rejected");
+            return FALSE;
+        }
+    }
+
     for (i = 0; i < count; i++)
     {
         char item[PATH_MAX_LEN + 8];
@@ -295,6 +319,8 @@ static BOOL TypeTextIntoWindow(CONST_STRPTR text)
     LONG n, i;
 
     if (!text || !text[0]) return FALSE;
+    /* last line of defence: never type a control character */
+    if (HasControlChars(text)) return FALSE;
     if (!EnsureInputLibraries())
     {
         DBG("drop text: keymap/input.device non disponibili");
